# mibare reads these from the process environment and does not load `.env`
# files itself. Export them in your shell (or source a gitignored copy of this
# file with `set -a; . ./.env; set +a`). Never commit secrets.

# Log verbosity for mibare (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# MIBARE_LOG_LEVEL=INFO

# Optional GitHub token; raises the API rate limit when resolving repositories.
# GITHUB_TOKEN=
